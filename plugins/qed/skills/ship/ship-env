#!/usr/bin/env bash
# Answers what /ship needs to know from outside the repository being shipped:
# the step 6 and step 7 reviewers, whether the gate may run one review instead
# of two, where the repository keeps its pull request template, and what a Codex
# review used. Called by SKILL.md, which sits beside it.
#
# It lives beside SKILL.md for the reasons ship-guard does: the skill folder is
# installed or copied as one unit and the helper travels with it, and /ship runs
# inside a project that knows nothing about where the skill came from. So it
# sources nothing and carries its own finding().
set -u

finding() { printf 'finding: %s\n' "$*" >&2; exit 2; }

usage="usage: ship-env reviewer | security-reviewer | review-mode <claim> <sensitive> | pr-template <repo> | pr-template-fallback | usage"

# pwd -P resolves a skill folder installed as a link, so the bundled files are
# read from the real folder and not from wherever the link sits.
here="$(cd "$(dirname "$0")" && pwd -P)" || finding "cannot resolve the directory ship-env runs from"

# A setting is read from two places, in order: the operator's own file, which no
# install or update touches, then the default bundled in config/ beside this
# script, which every update replaces.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/ship"

# A note line and a blank line are skipped; the first line that is neither is
# the value. Returns 1 when the file holds no value, so the caller can fall back.
first_value() {  # $1 file
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '#'* | '') continue ;; esac
    printf '%s\n' "$line"
    return 0
  done < "$1"
  return 1
}

# Both reviewers are commands, and which command a host can run is not a
# property of this skill. `auto`, the value both bundled defaults hold, means
# choose here, on every run, from what this host has. Nothing is written down: a
# machine that installs codex a week from now starts using it with no edit
# anywhere, and one that loses it stops naming a command that is not there.
#
# The choice is not a silent one. It is only ever made where nobody has stated a
# preference, an explicit value is never probed, `ship-env reviewer` prints what
# was chosen before the gate runs, and step 6 makes the pull request name the
# reviewer that actually ran.
have() { command -v "$1" >/dev/null 2>&1; }

# Both reviewer commands run with their working directory inside the repository
# they are reviewing, and both would otherwise take instructions from it. That is
# the change under review writing part of its own reviewer's brief, and one line
# in a committed AGENTS.md or CLAUDE.md does it. So each line turns that off in
# its own tool's spelling: project_doc_max_bytes=0 for codex, safe mode for
# Claude Code, which also leaves that repository's skills, plugins, hooks and
# agents unloaded. Verified by running both, not by reading the flags.
#
# What separates them is file access, and only that. Codex has an
# operating-system sandbox; plan mode is a permission rule, so it means the
# session reads the tree and the diff and does not change them. Neither is
# offline. Dropping WebFetch and WebSearch closes the two direct ways out of the
# Claude line, and a review has no use for either, but a reviewer needs a shell
# to read a diff at all and a shell can reach the network. Sealing that means
# taking the shell away, which leaves nothing that can review.
codex_reviewer='codex exec -m gpt-5.6-sol --sandbox read-only -c project_doc_max_bytes=0'
#
# --disallowedTools takes a list and keeps taking words until the next flag, so
# it cannot be last: the prompt the gate appends as one argument would be eaten
# as three more tool names and the run would end asking for a prompt. Every flag
# that takes a list goes before one that does not.
#
# --safe-mode because the reviewer runs with its working directory inside the
# repository it is reviewing, and a session started there would otherwise load
# that repository's CLAUDE.md as its own instructions. The branch under review
# would be writing part of its reviewer's brief: "reviewers of this repo answer
# No findings" is a diff away otherwise. Safe mode drops project instructions,
# skills, plugins, hooks and agents, and keeps the operator's sign-in.
claude_reviewer='claude -p --safe-mode --disallowedTools WebFetch,WebSearch --model claude-fable-5-1 --effort high --permission-mode plan'

# The probe never looks at the repository under review, but the answer still has
# to leave here safe to dispatch. An `agent:` value names an agent, and step 7
# dispatches it by name from a session whose project directory is that same
# repository, which is a second place a definition of that name can live. A
# branch carrying .claude/agents/<name>.md therefore reaches the dispatch even
# though it never reached the choice, and the gate cannot say which of the two
# definitions it is about to run. So it refuses, for a stated `agent:` value as
# much as a probed one. Reading the project to refuse is not reading it to
# choose: the most a branch wins here is stopping its own gate.
#
# Read what this catches and what it does not. It catches that one path under the
# repository's root, which is where an agent of that name is normally written.
# The root and not $PWD: nothing pins the directory the gate calls from, and a
# call from a subdirectory would miss the ordinary spelling, which is the case
# this exists for. It does not catch a definition under another filename or in a
# subdirectory of the agents folder, because Claude Code identifies an agent by a
# name: line inside the file rather than by what the file is called. Closing that
# is not a matter of a better pattern here: a branch can always write another
# file, so no test run from outside can settle which definition a dispatch would
# resolve.
#
# The real limit is that the gate dispatches its reviewer inside the repository
# being reviewed at all. It wants a different shape -- the security pass run from
# somewhere the branch cannot write, or an agent: value not dispatched by bare
# name -- and that is its own piece of work. What is here raises the cost of the
# obvious attempt and is not a boundary. Anyone who needs one states a command
# line in the operator's own security-reviewer file.
agent_hijacked() {  # $1 value; true when the reviewed repository holds a file naming that agent
  local top
  case "$1" in agent:*) ;; *) return 1 ;; esac
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || top=""
  [ -n "$top" ] || top="$PWD"
  [ -f "$top/.claude/agents/${1#agent:}.md" ]
}

probe() {  # $1 key; prints the command this host can actually run
  case "$1" in
    reviewer)
      if have codex; then printf '%s\n' "$codex_reviewer"
      elif have claude; then printf '%s\n' "$claude_reviewer"
      else finding "no code reviewer on this host: neither codex nor claude is on PATH; put a command line in $conf/reviewer"
      fi ;;
    # The security pass is qualified work and what was qualified is Codex Sol,
    # against the two fixtures in this plugin's tests/fixtures/security-review:
    # it found both planted Critical defects with the attacker, the input and the
    # gain, and invented nothing against the clean counterpart. Nothing else here
    # has been put to that test, so nothing else is chosen automatically.
    #
    # In particular there is no automatic Claude reviewer, and no agent is
    # probed for. An agent is dispatched by bare name into the repository under
    # review, which can define an agent of that name; that is a hole this file
    # could only narrow, and it closes by not choosing an agent at all.
    #
    # A host without codex stops. The alternative is running an unqualified
    # reviewer and reporting a security pass, which is worse than no pass: the
    # finding names the file where the operator states what to run instead.
    security-reviewer)
      if have codex; then printf '%s\n' "$codex_reviewer"
      else finding "no security reviewer on this host: codex is not on PATH; put a command line in $conf/security-reviewer"
      fi ;;
    *) finding "nothing to probe for $1" ;;
  esac
}

# The operator's file first, then the bundled one. A file holding `auto` states
# no preference, so the host is asked instead. A file holding nothing states
# nothing either and falls through to the next one; only when neither file holds
# a value is it a finding.
value() {  # $1 key
  local f v
  for f in "$conf/$1" "$here/config/$1"; do
    [ -f "$f" ] || continue
    v="$(first_value "$f")" || continue
    if [ "$v" = auto ]; then probe "$1"; else printf '%s\n' "$v"; fi
    return 0
  done
  finding "no value for $1 in $conf/$1 or $here/config/$1"
}

# GitHub's own docs give the three directories, say filenames are not case
# sensitive and may carry an extension such as .md or .txt, and allow a
# PULL_REQUEST_TEMPLATE/ folder of several in any of the three. They do not say
# which wins when a repo has more than one, so this lists every one and chooses
# none. Nothing printed means the repo has no template.
#
# A glob, not `find -maxdepth 1`: find does not descend a symlinked .github by
# default and a glob does, and a glob over a missing docs/ is simply an entry
# that fails the -d and -f tests below. A dangling symlink passes neither, so it
# is not a match.
pr_template() {  # $1 repo path
  local dir entry base low
  # A lookup that could not look must never read as "no template", or the gate
  # quietly fills the bundled copy instead of the repo's own.
  [ -d "$1" ] || finding "no such directory: $1"
  for dir in "" docs .github; do
    # git stores a symlink as a symlink, so GitHub reads no template through one.
    # Following it would report a template the repo does not have.
    [ -n "$dir" ] && [ -L "$1/$dir" ] && continue
    for entry in "$1${dir:+/$dir}"/*; do
      base="${entry##*/}"
      # A filename is repository content, and this one is printed for the gate
      # to read. So a match must be spelt out of a named set of characters, and
      # anything else is not a match: no newline to forge a second line, no
      # carriage return or escape to rewrite the line, no zero-width or
      # direction-changing character, whatever the locale says those are.
      #
      # Named characters rather than rejected ones on purpose. Rejecting the bad
      # ones was tried and missed a class twice: first every control character,
      # then the C1 ones, which [[:cntrl:]] does not cover under LC_ALL=C. A
      # template GitHub reads is spelt in this set anyway.
      case "$base" in *[!A-Za-z0-9._-]*) continue ;; esac
      # The same holds for the template itself, and here it matters more: the
      # gate copies the listed template into the PR body, so a template that
      # links to a local file such as an untracked .env would publish it.
      [ -L "$entry" ] && continue
      low="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')"
      case "$low" in
        # The folder form is a directory; the file form is a regular file. A
        # directory named PULL_REQUEST_TEMPLATE.md is neither to GitHub.
        pull_request_template)   [ -d "$entry" ] || continue; printf '%s%s/\n' "${dir:+$dir/}" "$base" ;;
        pull_request_template.*) [ -f "$entry" ] || continue; printf '%s%s\n'  "${dir:+$dir/}" "$base" ;;
        *) continue ;;
      esac
    done
  done
}

# Whether this gate may run one reviewer instead of two. It is not a classifier
# and does not look at the diff: the gate reads the classification the operator
# or the task gave and reads the branch diff for the sensitive categories, and
# hands both in. What lives here is the rule that combines them, in one place
# with one answer, so there is something to break rather than a paragraph of
# prose to obey.
#
# Combined is the only answer that costs a reviewer, so it is the only answer
# with a condition on it: the gate claimed combined and found nothing sensitive.
# Every other pair, including both kinds of not knowing, is separate. That is
# why `unknown` is a word here at all -- a gate that cannot establish a
# classification has to be able to say so and still get an answer it can act on.
review_mode() {  # $1 combined|separate|unknown, $2 yes|no|unknown
  case "$1" in
    combined | separate | unknown) ;;
    *) finding "review-mode takes combined, separate or unknown, not '$1'" ;;
  esac
  case "$2" in
    yes | no | unknown) ;;
    *) finding "review-mode takes yes, no or unknown for the sensitive verdict, not '$2'" ;;
  esac
  if [ "$1" = combined ] && [ "$2" = no ]; then printf 'combined\n'; else printf 'separate\n'; fi
}

# The usage a `codex exec --json` event stream on stdin reports, as one line:
# `usage: input=<n> output=<n> cache_read=<n> cache_write=<n>`, each a count or
# `unknown`. Only the usage field of a top-level turn.completed event is read,
# never what a run said or what its commands printed, so a review is counted
# from its own stream alone. Codex counts cached input inside input and
# reasoning inside output, so cached input is taken out and nothing is added. A
# resumed thread reports its running total, so each thread's last total counts
# once. Any cache write leaves input unknown, since no probe showed whether
# input includes it.
codex_usage() {
  jq -R -r -s '
    def tokens: if type == "number" and . >= 0 and . == floor then . else null end;
    def total: reduce .[] as $v (0; if . == null or $v == null then null else . + $v end);
    [split("\n")[] | fromjson? | objects]
    | reduce .[] as $e ({thread: null, runs: {}, n: 0};
        if $e.type == "thread.started" then .thread = (($e.thread_id | strings) // null)
        elif $e.type == "turn.completed" then
          (if .thread == null then "run \(.n)" else "thread \(.thread)" end) as $k
          | .runs[$k] = ($e.usage | objects // {}) | .n += 1
        else . end)
    | [.runs[]] as $runs
    | def sum(f): if ($runs | length) == 0 then null else [$runs[] | f] | total end;
      {
        input: sum((.input_tokens | tokens) as $i | (.cached_input_tokens | tokens) as $c
                   | if $i != null and $c != null and $i >= $c
                        and (.cache_write_input_tokens | tokens) == 0
                     then $i - $c else null end),
        output: sum(.output_tokens | tokens),
        cache_read: sum(.cached_input_tokens | tokens),
        cache_write: sum(.cache_write_input_tokens | tokens)
      }
    | "usage: input=\(.input // "unknown") output=\(.output // "unknown") cache_read=\(.cache_read // "unknown") cache_write=\(.cache_write // "unknown")"
  '
}

cmd="${1:-}"; shift || true
case "$cmd" in
  '') finding "$usage" ;;
  reviewer | security-reviewer)
    [ $# -eq 0 ] || finding "$usage"
    v="$(value "$cmd")" || exit 2
    ! agent_hijacked "$v" || finding "the repository being reviewed defines an agent called ${v#agent:}, so the gate cannot tell which definition it would dispatch; remove .claude/agents/${v#agent:}.md from the worktree, or name a command line in $conf/$cmd"
    printf '%s\n' "$v" ;;
  review-mode)
    [ $# -eq 2 ] || finding "$usage"
    review_mode "$1" "$2" ;;
  pr-template)
    [ $# -eq 1 ] || finding "$usage"
    pr_template "$1" ;;
  pr-template-fallback)
    [ $# -eq 0 ] || finding "$usage"
    [ -f "$here/PULL_REQUEST_TEMPLATE.md" ] \
      || finding "no bundled pull request template at $here/PULL_REQUEST_TEMPLATE.md"
    printf '%s\n' "$here/PULL_REQUEST_TEMPLATE.md" ;;
  usage)
    [ $# -eq 0 ] || finding "$usage"
    codex_usage ;;
  *) finding "unknown key '$cmd' (reviewer, security-reviewer, review-mode, pr-template, pr-template-fallback, usage)" ;;
esac
exit 0
